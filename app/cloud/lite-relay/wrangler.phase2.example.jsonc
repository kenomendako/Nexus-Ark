{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexus-ark-lite-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["global_fetch_strictly_public", "enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-ark-lite-relay",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MODEL_CATALOG_CACHE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/v1/*"]
  },
  "triggers": { "crons": ["17 3 * * *", "*/5 * * * *"] },
  "secrets": {
    // GEMINI_PERSONAL_2/3 は旅行前に所有者が任意で登録する予備枠です。requiredには含めません。
    "required": [
      "OWNER_AUTH_TOKEN",
      "BUNDLE_SIGNING_KEY",
      "STANDBY_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "APP_MODE": "phase5-unified-lite",
    "BUILD_ID": "phase5-local-build",
    "STANDBY_ENCRYPTION_KEY_ID": "standby-key-1",
    "LITE_ALLOWED_ORIGIN": "https://REPLACE_WITH_YOUR_LITE_ORIGIN",
    "PHASE0_GEMINI_MODEL": "disabled",
    "PHASE0_OPENAI_MODEL": "disabled",
    "PHASE0_ANTHROPIC_MODEL": "disabled",
    "PHASE0_XAI_MODEL": "disabled",
    "PHASE0_OPENROUTER_MODEL": "disabled"
  }
}
